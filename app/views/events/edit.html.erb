<% content_for :title, "edit plan | freeslot" %>

<%= link_to "back to plan", event_path(@event), class: "text-sm font-semibold text-mist hover:text-ink" %>
<h1 class="mt-4 text-4xl font-extrabold tracking-tight">edit plan</h1>

<%= render "form", event: @event %>

<div data-controller="clipboard" class="mt-8 rounded-3xl border border-line bg-white p-5">
  <p class="font-bold">manage from another device</p>
  <p class="mt-1 text-sm text-mist">open this link on your phone or laptop to edit the plan there too. anyone with it can edit or delete the plan, so keep it to yourself.</p>
  <div class="mt-3 flex gap-2">
    <input type="text" readonly value="<%= manage_event_url(@event, token: @event.owner_token) %>"
           data-clipboard-target="source"
           class="flex-1 min-w-0 rounded-full border border-line bg-paper px-4 py-3 text-base">
    <button type="button" data-action="clipboard#copy" data-clipboard-target="button"
            class="rounded-full bg-ink px-5 font-bold text-white hover:bg-grape transition-colors">copy</button>
  </div>
</div>

<div class="mt-8 rounded-3xl border border-red-200 bg-white p-5">
  <p class="font-bold">delete this plan</p>
  <p class="mt-1 text-sm text-mist">removes it for everyone, including all the times people picked. this can't be undone.</p>
  <%= button_to "delete plan", event_path(@event), method: :delete,
        form: { data: { turbo_confirm: "delete \"#{@event.title}\" for everyone?" } },
        class: "mt-3 rounded-full border border-red-300 px-5 py-3 font-bold text-red-700 hover:bg-red-50 cursor-pointer" %>
</div>
