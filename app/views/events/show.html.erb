<% content_for :title, "#{@event.title} · Freeslot" %>
<%= turbo_stream_from @event %>

<h1 class="text-2xl sm:text-3xl font-bold"><%= @event.title %></h1>
<p class="text-stone-600 mt-1">
  <%= @event.start_date.strftime("%a %-d %b") %> – <%= @event.end_date.strftime("%a %-d %b") %>,
  <%= format("%02d:00", @event.start_hour) %>–<%= format("%02d:00", @event.end_hour) %>
</p>

<div data-controller="clipboard" class="mt-6 flex gap-2">
  <input type="text" readonly value="<%= event_url(@event) %>"
         data-clipboard-target="source"
         class="flex-1 min-w-0 rounded-lg border border-stone-300 bg-white px-3 py-2 text-sm">
  <button type="button" data-action="clipboard#copy" data-clipboard-target="button"
          class="rounded-lg bg-stone-900 text-white px-4 text-sm hover:bg-stone-700">
    Copy
  </button>
</div>

<% if @participant %>
  <p class="mt-8 text-sm text-stone-600">
    You're <strong class="text-stone-900"><%= @participant.name %></strong>.
    Tap the times you're free, tap again to undo.
    <span class="hidden sm:inline">Click and drag to select a range.</span>
  </p>
<% else %>
  <%= form_with model: [@event, Participant.new], class: "mt-8 flex gap-2" do |f| %>
    <%= f.text_field :name, placeholder: "Your name", required: true, maxlength: 30,
          class: "flex-1 min-w-0 rounded-lg border border-stone-300 bg-white px-3 py-2" %>
    <%= f.submit "Join", class: "rounded-lg bg-stone-900 text-white px-5 font-medium hover:bg-stone-700 cursor-pointer" %>
  <% end %>
  <p class="mt-2 text-xs text-stone-500">Already joined on another device? Enter the same name.</p>
<% end %>

<% if @best_ranges.any? %>
  <div class="mt-6 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-900">
    <span class="font-semibold">Best <%= @best_ranges.size == 1 ? "time" : "times" %>:</span>
    <%= @best_ranges.first(3).map { |from, to| "#{from.strftime('%a %-d %b, %H:%M')}–#{to.strftime('%H:%M')}" }.to_sentence %>
    <span class="text-emerald-700">(<%= @best_count %>/<%= @names.size %> free)</span>
  </div>
<% end %>

<%= render "grid", event: @event, counts: @counts, my_slots: @my_slots,
           total: @names.size, participant: @participant %>

<div class="mt-3 flex flex-wrap items-center gap-x-6 gap-y-2 text-xs text-stone-500">
  <div class="flex items-center gap-2">
    <span>Nobody</span>
    <span class="h-3 w-24 rounded border border-stone-200"
          style="background: linear-gradient(to right, rgba(16,185,129,0), rgba(16,185,129,0.85));"></span>
    <span>Everyone</span>
  </div>
  <% if @participant %>
    <div class="flex items-center gap-2">
      <span class="h-3 w-3 rounded-sm ring-2 ring-inset ring-stone-900"></span>
      Your times
    </div>
  <% end %>
</div>

<% if @names.any? %>
  <p class="mt-4 text-sm text-stone-600">
    <%= pluralize(@names.size, "person") %> responded: <%= @names.to_sentence %>
  </p>
<% end %>
