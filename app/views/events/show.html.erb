<% content_for :head do %>
  <meta property="og:title" content="<%= @event.title %>">
  <meta property="og:description" content="when are you free? tap your times, no sign-up needed.">
  <meta property="og:url" content="<%= event_url(@event) %>">
<% end %>
<% content_for :title, "#{@event.title} | freeslot" %>
<%= turbo_stream_from @event %>

<h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight leading-none"><%= @event.title %></h1>
<p class="mt-2 text-mist">
  <%= @event.start_date.strftime("%a %-d %b") %> to <%= @event.end_date.strftime("%a %-d %b") %>,
  <%= format("%02d:00", @event.start_hour) %>–<%= format("%02d:00", @event.end_hour) %>
</p>

<div data-controller="clipboard share"
     data-share-title-value="<%= @event.title %>"
     data-share-text-value="when are you free for <%= @event.title %>? add your times here 👇"
     data-share-url-value="<%= event_url(@event) %>"
     class="mt-6 rounded-3xl bg-grape p-5 text-white">
  <p class="text-lg font-bold">send this to the group chat</p>

  <button type="button" hidden data-share-target="button" data-action="share#share"
          class="mt-3 w-full rounded-full bg-sun py-4 text-lg font-bold text-ink hover:bg-white transition-colors cursor-pointer">
    share link
  </button>

  <div class="mt-3 flex gap-2">
    <input type="text" readonly value="<%= event_url(@event) %>"
           data-clipboard-target="source"
           class="flex-1 min-w-0 rounded-full bg-white/15 px-4 py-3 text-base text-white">
    <button type="button" data-action="clipboard#copy" data-clipboard-target="button"
            class="rounded-full bg-white px-5 font-bold text-ink hover:bg-sun transition-colors">copy</button>
  </div>
</div>

<% if @participant %>
  <p class="mt-8 text-lg">
    hey <strong><%= @participant.name %></strong>, tap when you're free<span class="hidden sm:inline"> (or click and drag)</span>.
  </p>
<% else %>
  <div class="mt-8 rounded-3xl border border-line bg-white p-5">
    <p class="text-lg font-bold">who are you?</p>
    <%= form_with model: [@event, Participant.new], class: "mt-3 flex gap-2" do |f| %>
      <%= f.text_field :name, placeholder: "your name", required: true, maxlength: 30,
            class: "flex-1 min-w-0 rounded-full border border-line bg-paper px-4 py-3 text-base" %>
      <%= f.submit "i'm in",
            class: "rounded-full bg-ink px-6 font-bold text-white hover:bg-grape transition-colors cursor-pointer" %>
    <% end %>
    <p class="mt-2 text-sm text-mist">on another device? use the same name to pick up where you left off.</p>
  </div>
<% end %>

<% if @best_ranges.any? && @names.size >= 2 %>
  <% everyone = @names.size >= 2 && @best_count == @names.size %>
  <% times = @best_ranges.first(3).map { |from, to| "#{from.strftime('%a %-d %b, %H:%M')}–#{to.strftime('%H:%M')}" }.to_sentence %>
  <div class="mt-6 rounded-3xl px-5 py-4 <%= everyone ? 'bg-sun' : 'bg-grape-soft' %>">
    <p class="font-bold"><%= everyone ? "everyone's free 🎉" : "best so far (#{@best_count} of #{@names.size})" %></p>
    <p class="mt-1"><%= times %></p>
  </div>
<% end %>

<%= render "grid", event: @event, counts: @counts, my_slots: @my_slots,
           total: @names.size, participant: @participant %>

<div class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-mist">
  <span class="flex items-center gap-2">
    1 person
    <span class="h-3 w-20 rounded-full"
          style="background: linear-gradient(to right, rgba(109,74,255,0.18), rgba(109,74,255,0.85));"></span>
    most
  </span>
  <span class="flex items-center gap-2">
    <span class="h-3 w-3 rounded-sm" style="background-color: #ffd23f;"></span>
    everyone
  </span>
  <% if @participant %>
    <span class="flex items-center gap-2">
      <span class="h-3 w-3 rounded-sm ring-2 ring-inset ring-ink"></span>
      you
    </span>
  <% end %>
</div>

<% if @names.any? %>
  <div class="mt-8">
    <p class="font-bold"><%= pluralize(@names.size, "person") %> in</p>
    <div class="mt-2 flex flex-wrap gap-2">
      <% @names.each do |name| %>
        <span class="rounded-full border bg-white px-3 py-1 text-sm <%= @participant&.name == name ? 'border-ink font-semibold' : 'border-line' %>"><%= name %></span>
      <% end %>
    </div>
  </div>
<% end %>
