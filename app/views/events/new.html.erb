<% content_for :head do %>
  <meta property="og:title" content="freeslot">
  <meta property="og:description" content="make a plan, drop the link in the group chat, see when everyone's free.">
<% end %>

<h1 class="text-5xl sm:text-6xl font-extrabold tracking-tight leading-[0.95]">
  when's everyone<br>actually free?
</h1>
<p class="mt-4 text-lg text-mist max-w-md">
  make a plan, drop the link in the group chat, and watch the times line up. no sign-ups.
</p>

<% if @recent_events.present? %>
  <section class="mt-8">
    <h2 class="text-lg font-bold">your plans</h2>
    <div class="mt-3 space-y-2">
      <% @recent_events.each do |event| %>
        <%= link_to event_path(event),
              class: "flex items-center justify-between gap-4 rounded-2xl border border-line bg-white px-4 py-3 hover:border-grape transition-colors" do %>
          <div class="min-w-0">
            <p class="font-bold truncate"><%= event.title %></p>
            <p class="text-sm text-mist"><%= event.start_date.strftime("%a %-d %b") %> to <%= event.end_date.strftime("%a %-d %b") %></p>
          </div>
          <span class="shrink-0 rounded-full bg-grape-soft px-3 py-1 text-sm font-semibold">
            <%= pluralize(event.participants.size, "person") %> in
          </span>
        <% end %>
      <% end %>
    </div>
  </section>
  <h2 class="mt-10 text-lg font-bold">start a new one</h2>
<% end %>

<%= render "form", event: @event %>
