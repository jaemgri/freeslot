<!DOCTYPE html>
<html>
  <head>
  <title><%= content_for(:title) || "freeslot" %></title>
  <% if hotwire_native_app? %>
    <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
  <% else %>
    <meta name="viewport" content="width=device-width,initial-scale=1">
  <% end %>
  <meta name="theme-color" content="#fbfaff">
  <meta name="application-name" content="freeslot">
  <meta name="apple-mobile-web-app-title" content="freeslot">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="mobile-web-app-capable" content="yes">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <meta property="og:site_name" content="freeslot">
  <meta property="og:type" content="website">
  <meta property="og:image" content="<%= "#{request.base_url}/og.png" %>">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <%= yield :head %>

  <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
  <link rel="icon" href="/icon.svg" type="image/svg+xml">
  <link rel="icon" href="/icon.png" type="image/png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&display=swap" rel="stylesheet">

  <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
  <%= turbo_refreshes_with method: :morph, scroll: :preserve %>
  </head>

  <body>
  <body class="bg-paper text-ink font-sans antialiased min-h-dvh">
  <header class="max-w-3xl mx-auto px-5 pt-5 flex items-center justify-between">
    <%= link_to root_path, class: "text-xl font-extrabold tracking-tight" do %>
      freeslot<span class="text-grape">.</span>
    <% end %>
    <%= link_to "+ new plan", root_path,
          class: "rounded-full border border-line bg-white px-4 py-2 text-sm font-semibold hover:border-grape" %>
  </header>

  <main class="max-w-3xl mx-auto px-5 pt-8 pb-16">
    <% if notice %>
      <p class="mb-6 rounded-2xl bg-grape-soft px-4 py-3 font-medium"><%= notice %></p>
    <% end %>
    <% if alert %>
      <p class="mb-6 rounded-2xl bg-red-50 text-red-700 px-4 py-3 font-medium"><%= alert %></p>
    <% end %>

    <%= yield %>
  </main>
</body>
</html>
